# Tethran environment. TEST NETWORKS ONLY. Every key here is a throwaway test key.
# Copy to .env (git-ignored) or run: cd contracts && npm run wallets
# Never put a mainnet key or real funds behind any of these.

# Which entry of config/chains.json to use
CHAIN=sepolia

# Optional RPC overrides per chain id (e.g. a provider URL with an API key)
# Sepolia: set this to your Alchemy Sepolia endpoint (same value as ALCHEMY_ETH_ENDPOINT). Never commit it.
RPC_URL_11155111=
RPC_URL_84532=

# Treasury / backend: deploys, funds escrows, holds RELEASER and MINTER roles
TREASURY_PRIVATE_KEY=
# Demo parties (in the product these are user wallets, not server keys)
CLIENT_PRIVATE_KEY=
PROVIDER_PRIVATE_KEY=
ARBITER_PRIVATE_KEY=
# Vault co-signers. Different processes: the agent signer module and the Policy Service.
AGENT_SIGNER_PRIVATE_KEY=
POLICY_SIGNER_PRIVATE_KEY=
# Operator: signs policy updates
OPERATOR_PRIVATE_KEY=

# LLM providers (services/llm). Keys are never committed. Model names are config because free tiers change.
# Groq first; Gemini is the fallback (used when Groq fails or rate-limits).
LLM_PROVIDER_ORDER=groq,gemini
GROQ_API_KEY=
# Checked 12 Nov 2026 against the Groq model list: schema-valid JSON in one call.
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# Checked 12 Nov 2026 against the model list for our key: all nine eval scenarios pass on this model.
GEMINI_MODEL=gemini-3.5-flash
# Optional third provider, only if the first two fail
NVIDIA_API_KEY=
NVIDIA_MODEL=
# Optional
LLM_TIMEOUT_MS=
OPIK_API_KEY=

# Alchemy (API-key path only). Used through RPC_URL_11155111 above.
ALCHEMY_API_KEY=
ALCHEMY_ETH_ENDPOINT=

# Backend and Policy Service (services/backend, services/policy)
ARBITER_ADDRESS=
POLICY_URL=http://127.0.0.1:8787
BACKEND_URL=http://127.0.0.1:8788
# Shared secret the Policy Service sends to the backend's /internal routes. Any long random string.
INTERNAL_TOKEN=
OPERATOR_ADDRESS=
# Stripe sandbox (not configured yet: the webhook is tested with locally signed events)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Opik cloud
OPIK_WORKSPACE=benedict258
OPIK_PROJECT_NAME=tethran

# Web app address: pay links, notification links and email links use it (default http://localhost:3000).
APP_BASE_URL=
# Invoice email through the Resend REST API. Empty: the email goes to the Emails outbox only and the app says so.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
# Optional: daily send cap (default 100) and a comma-separated recipient allowlist (empty = any address).
EMAIL_DAILY_CAP=
EMAIL_RECIPIENT_ALLOWLIST=
# Optional: invoice creations allowed per IP per minute (default 30).
INVOICE_RATE_LIMIT_PER_MIN=
# The address the test invoice email goes to (scripts/send-test-email.ts).
TEST_EMAIL=
# Web app: the Reown project id for wallet connection (a public id).
VITE_REOWN_PROJECT_ID=
